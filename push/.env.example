# The Worker's status URL.
STATUS_URL=https://lab-status.example.workers.dev/api/status
# The same value as the secret PUSH_TOKEN on the Worker.
PUSH_TOKEN=
# prometheus or static. A new source is a module in sources/.
SOURCE=prometheus
# 300 s is 288 KV writes each day. The Workers free plan allows 1,000.
INTERVAL_SECONDS=300
# The Prometheus source only.
PROMETHEUS_URL=http://prometheus:9090
# The static source only.
STATIC_UP=1
STATIC_TOTAL=1
